<%
  # 1200x630 preview card for link unfurls: the plate's content restacked, since the
  # 13:1 strip itself would shrink to a sliver in a 1.91:1 frame.
  name_ua = data['name'].to_s
  name_en = data['name_en'].to_s
  bilingual = name_en.present? && name_en != name_ua
  code = data['code'] || stop_code

  fit = ->(text, size, max_w) { [size, max_w / [text.length * 0.5, 1].max].min.round(1) }
  ua_size = fit.(name_ua, 84, 1080)
  en_size = fit.(name_en, 56, 1080)
%><?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" version="1.1">
  <style>
    text { font-family: 'Myriad Pro', sans-serif; fill: #fff; }
  </style>
  <rect width="1200" height="630" fill="#444240"/>

  <text x="60" y="100" font-size="40">Код зупинки</text>
  <text x="60" y="146" font-size="34" fill-opacity="0.75" style="fill-opacity:.75">Transport stop ID</text>
  <text x="54" y="368" font-size="260"><%= ERB::Util.h(code) %></text>

  <rect x="834" y="54" width="312" height="312" fill="#fff"/>
  <g transform="translate(846, 66) scale(<%= (288 / qr_side).round(4) %>)">
    <%= qrcode %>
  </g>

  <rect x="60" y="410" width="1080" height="3" fill="#fff" fill-opacity="0.35" style="fill-opacity:.35"/>
  <text x="60" y="<%= bilingual ? 500 : 530 %>" font-size="<%= ua_size %>"><%= ERB::Util.h(name_ua) %></text>
  <% if bilingual %>
  <text x="60" y="568" font-size="<%= en_size %>" style="fill-opacity:.8"><%= ERB::Util.h(name_en) %></text>
  <% end %>
  <text x="1140" y="600" font-size="26" text-anchor="end" style="fill-opacity:.6">lad.lviv.ua/<%= ERB::Util.h(code) %></text>
</svg>
