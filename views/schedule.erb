<?xml version="1.0" encoding="UTF-8"?>
<%
  # A4 landscape at 300 dpi, drawn on the city's CorelDRAW sheet for a route's first stop:
  # hours by minutes for workdays and weekends on the left, the stops ahead with minutes to
  # each on the right. Positions are the sheet's own.
  e = ->(s) { ERB::Util.html_escape(s.to_s) }
  route = sheet[:transfer]
  color = route['color'] || '#50B056'
  stops = sheet[:next_stops]

  pictogram = case route['vehicle_type']
              when 'tram' then 'ico-tram'
              when 'trolleybus' then 'ico-trolleybus'
              else route['route_normalized'].start_with?('n') ? 'ico-nightbus' : 'ico-bus'
              end

  title_scale = [1.0, 2100 / natgrotesk_width(data['name'], 100)].min
  title_en = data['name_en'].to_s
  title_en = '' if title_en == data['name'].to_s

  # Rows run over every hour either column has; the small hours after midnight sort last.
  hour_order = ->(h) { h < 4 ? h + 24 : h }
  hours = sheet[:departures].values.flat_map(&:keys)
  first_hour, last_hour = hours.map(&hour_order).minmax
  rows = (first_hour..last_hour).to_a
  row_step = [87.5, 1487.5 / [rows.length - 1, 1].max].min
  # A column with more minutes in an hour than the sheet's nine narrows them to fit.
  per_hour = sheet[:departures].values.flat_map { |by_hour| by_hour.values.map(&:length) }.max
  # Two day columns share the sheet's 2259 px as drawn; a route whose Saturday and Sunday
  # differ gets three, each a third as wide with its minutes squeezed to fit.
  labels = {
    'workday' => ['Робочі дні', 'Working days'], 'weekend' => %w[Вихідні Weekend],
    'saturday' => %w[Субота Saturday], 'sunday' => %w[Неділя Sunday]
  }
  col_width = 2259.0 / sheet[:departures].length
  minute_step = [94.85, (col_width - 239.5) / per_hour].min
  minute_size = 58.33 * minute_step / 94.85

  columns = sheet[:departures].keys.each_with_index.map do |day, i|
    dx = (col_width * i).round(2)
    { day: day, ua: labels[day][0], en: labels[day][1], dx: dx,
      divider: (346.78 + dx).round(2), rule: [251.0 + dx, (251.0 + dx + col_width - 105.5).round(2)] }
  end

  # The stop list: the sheet's 186 px between names, squeezed (with the text) for long lines.
  pitch = [186.12, 1675.14 / [stops.length - 1, 1].max].min
  text_scale = pitch / 186.12
  line_end = 409.19 + pitch * (stops.length - 1)
  name_room = 3480 - 2869.92
  badge_label = ->(r) { %w[tram trolleybus].include?(r['vehicle_type']) ? r['route'].to_s.sub(/\A[ТтTt]0*/, '') : r['route'].to_s }

  # Row 0 is this stop, at the head of the line; the rest are the stops ahead.
  sheet_rows = [sheet[:here], *stops]
  stop_rows = sheet_rows.map { |s| Array(s['transfers']) }
  last = stop_rows.length - 1
  row_y = ->(i) { i.zero? ? 221.91 : (409.19 + pitch * (i - 1)).round(2) }
  line_x = 2813.54
  lanes = parallel_lanes(route, stop_rows)
  lane_x = ->(slot) { (2781.05 - 29.53 * slot).round(2) }
  at_row = ->(lane, i) { lane[:runs].any? { |a, b| (a..b).cover?(i) } }
  # A stop's marker spans the lanes stopping there; on its own line it is the sheet's short one.
  pill_left = ->(i) { slots = lanes.each_index.select { |k| at_row.(lanes[k], i) }; slots.empty? ? 2794.76 : lane_x.(slots.max) }

  # A route badge centred on 0,0: trams in a diamond, trolleybuses in a square, buses as
  # their round route sign (a square cannot fit "А03").
  badge = lambda do |r|
    unless %w[tram trolleybus].include?(r['vehicle_type'])
      next %(<image xlink:href="#{icon_href(normalize_route_name(r['route']))}" x="-27" y="-27" width="54" height="54"/>)
    end

    label = badge_label.(r)
    shape = if r['vehicle_type'] == 'tram'
              %(<rect x="-23.71" y="-23.71" width="47.42" height="47.42" rx="8.03" transform="rotate(45)" fill="#{e.(r['color'])}"/>)
            else
              %(<rect x="-25.38" y="-25.38" width="50.75" height="50.75" rx="8.6" fill="#{e.(r['color'])}"/>)
            end
    %(#{shape}<text y="11.5" text-anchor="middle" fill="#{e.(r['text_color'] || '#FFFFFF')}" style="font-size:#{label.length > 2 ? 26 : 34}px">#{e.(label)}</text>)
  end
  pictograms = { tram: ['ico-tram', 38.5], trol: ['ico-trolleybus', 44] }
%>
<svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" width="3508px" height="2480px" version="1.1" style="shape-rendering:geometricPrecision; text-rendering:geometricPrecision; image-rendering:optimizeQuality; fill-rule:evenodd; clip-rule:evenodd"
viewBox="0 0 3508 2480.4"
 xmlns:xlink="http://www.w3.org/1999/xlink">
 <defs>
  <style type="text/css">
   <![CDATA[
    <%= erb :fonts %>
    @font-face { font-family: "NatGrotesk"; font-weight: normal; font-style: normal; src: url("data:font/otf;base64,<%= NATGROTESK_OTF %>") format("opentype"); }
    text { font-family: 'NatGrotesk', 'Myriad Pro', sans-serif; }
    .hour {font-family:'MyriadPro-Semibold', 'NatGrotesk', sans-serif; font-size:58.33px}
    .str0 {stroke:#9DA7B3;stroke-width:2.36;stroke-miterlimit:22.9256}
    .str1 {stroke:#9DA7B3;stroke-width:2.36;stroke-miterlimit:22.9256;stroke-dasharray:2.360000 7.090000}
    .str2 {stroke:#2B2A29;stroke-width:2.36;stroke-miterlimit:22.9256}
    .str9 {stroke:#2B2A29;stroke-width:4.72;stroke-miterlimit:22.9256}
    .str11 {stroke:#9DA7B3;stroke-width:0.9;stroke-miterlimit:22.9256}
    .str12 {stroke:#9DA7B3;stroke-width:4.72;stroke-miterlimit:22.9256}
    .str13 {stroke:#BDCCDB;stroke-width:0.9;stroke-miterlimit:22.9256}
    .fil0 {fill:#9DA7B3;fill-rule:nonzero}
    .fil2 {fill:#FEFEFE}
    .fil3 {fill:#2B2A29}
    .fil4 {fill:#9DA7B3}
    .fil5 {fill:none}
    .fil6 {fill:#FECD27}
    .fnt2 {font-size:58.33px}
    .fnt3 {font-size:45.83px}
    .fnt5 {font-size:33.33px}
    .fnt6 {font-weight:300;font-size:75px;font-family:'Bookman Old Style'}
    .fnt7 {font-size:65.58px}
    .fnt8 {font-size:37.5px}
    .fnt9 {font-size:20.83px}
   ]]>
  </style>
 </defs>
 <g>
  <image xlink:href="<%= icon_href(e.(route['route_normalized'])) %>" x="47" y="108" width="236" height="236"/>
  <image xlink:href="<%= icon_href(pictogram) %>" x="440" y="100" width="140" height="210"/>
  <text x="661.15" y="217.42" class="fil3" style="font-size:<%= (100 * title_scale).round(2) %>px"><%= e.(data['name']) %></text>
  <% unless title_en.empty? %>
  <text x="661.15" y="302.25" class="fil4" style="font-size:<%= (75 * title_scale).round(2) %>px"><%= e.(title_en) %></text>
  <% end %>
  <line class="fil5 str0" x1="140.71" y1="554.97" x2="2408.74" y2="554.97"/>

  <% columns.each do |col| dx = col[:dx] %>
  <text x="<%= 174.42 + dx %>" y="474.97" class="fil3 fnt2"><%= col[:ua] %></text>
  <text x="<%= 174.42 + dx %>" y="526.25" class="fil4 fnt3"><%= col[:en] %></text>
  <text x="<%= 172.43 + dx %>" y="607.94" class="fil3 fnt3">години</text>
  <text x="<%= 237.23 + dx %>" y="645.93" class="fil4 fnt5">hours</text>
  <text x="<%= 379.13 + dx %>" y="607.94" class="fil3 fnt3">хвилини</text>
  <text x="<%= 379.13 + dx %>" y="645.93" class="fil4 fnt5">minutes</text>
  <line class="fil5 str0" x1="<%= col[:divider] %>" y1="663.41" x2="<%= col[:divider] %>" y2="2228.23"/>
  <% rows.each_with_index do |h, i| y = (726.13 + row_step * i).round(2) %>
  <text x="<%= 323 + dx %>" y="<%= y %>" text-anchor="end" class="hour fil3"><%= h % 24 %></text>
  <% sheet[:departures][col[:day]].fetch(h % 24, []).each_with_index do |m, j| %>
  <text x="<%= (384.19 + dx + minute_step * j).round(2) %>" y="<%= y %>" class="fil3" style="font-size:<%= minute_size.round(2) %>px"><%= format('%02d', m) %></text>
  <% end %>
  <% unless i == rows.length - 1 %>
  <line class="fil5 str1" x1="<%= col[:rule][0] %>" y1="<%= (y + 11.8).round(2) %>" x2="<%= col[:rule][1] %>" y2="<%= (y + 11.8).round(2) %>"/>
  <% end %>
  <% end %>
  <% end %>

  <line x1="<%= line_x %>" y1="221.91" x2="<%= line_x %>" y2="<%= line_end.round(2) %>" stroke="<%= e.(color) %>" stroke-width="23.62"/>
  <%# Same-kind routes alongside: a lane over each run, joining just above its first stop
      and leaving just below its last, with its badge where it leaves. %>
  <% ending = Hash.new { |h, k| h[k] = [] } %>
  <% lanes.each_with_index do |lane, slot| %>
  <% lane[:runs].each do |a, b|
       y1 = a.zero? ? row_y.(0) : (row_y.(a) - 45 * text_scale).round(2)
       y2 = b == last ? row_y.(last) : (row_y.(b) + 38.4 * text_scale).round(2)
       ending[b] << slot unless b == last %>
  <line x1="<%= lane_x.(slot) %>" y1="<%= y1 %>" x2="<%= lane_x.(slot) %>" y2="<%= y2 %>" stroke="<%= e.(lane[:route]['color']) %>" stroke-width="17.72"/>
  <% end %>
  <% end %>
  <%# Badges leaving at one stop step down to the left; past two, a badge's width apart and
      less steeply, so the last stays above the next stop's interchanges. %>
  <% ending.each do |b, slots| dx, dy = slots.length > 2 ? [59.06, 37.8 / (slots.length - 1)] : [38, 37.8] %>
  <% slots.sort.each_with_index do |slot, k| %>
  <g transform="translate(<%= (lane_x.(slots.min) - 11.8 - dx * k * text_scale).round(2) %> <%= (row_y.(b) + (77.7 + dy * k) * text_scale).round(2) %>) scale(<%= text_scale.round(4) %>)"><%= badge.(lanes[slot][:route]) %></g>
  <% end end %>
  <%# The routes that reach the end of the line, the sheet's own first, under its last stop:
      clear of the marker, which does not shrink with the list (17.12 is half its height). %>
  <% [route, *lanes.select { |l| at_row.(l, last) }.map { |l| l[:route] }].each_with_index do |r, k| %>
  <g transform="translate(<%= (line_x - 65 * k * text_scale).round(2) %> <%= (row_y.(last) + 17.12 + 44.38 * text_scale).round(2) %>) scale(<%= text_scale.round(4) %>)"><%= badge.(r) %></g>
  <% end %>
  <%# Each stop's marker, with the other electric kind's interchanges to its left: badges,
      the kind's pictogram, and a dotted lead to the marker. %>
  <% stop_rows.each_with_index do |transfers, i| left = pill_left.(i); cy = row_y.(i) %>
  <% if sheet_rows[i]['gap'] %>
  <% [-1, 0, 1].each do |k| %>
  <circle cx="<%= line_x %>" cy="<%= (cy + 30 * k * text_scale).round(2) %>" r="<%= (6 * text_scale).round(2) %>" class="fil2"/>
  <% end; next end %>
  <rect x="<%= (left - 14.76).round(2) %>" y="<%= (cy - 14.76).round(2) %>" width="<%= (line_x - left + 29.52).round(2) %>" height="29.52" rx="14.76" class="fil2 str9"/>
  <% groups = other_electric(route, transfers + Array(sheet_rows[i]['nearby']),
                             lanes.select { |l| at_row.(l, i) }.map { |l| l[:route]['route'] }); next if groups.empty? %>
  <g transform="translate(<%= (left - 14.76).round(2) %> <%= cy %>) scale(<%= text_scale.round(4) %>)">
   <line x1="-6" y1="0" x2="-24.4" y2="0" stroke="#9DA7B3" stroke-width="2.36" stroke-dasharray="2.36 2.36"/>
   <% x = -26.2; groups.each do |type, ts| icon, w = pictograms[type] %>
   <image xlink:href="<%= icon_href(icon) %>" x="<%= (x - w).round(2) %>" y="-38" width="<%= w %>" height="68" preserveAspectRatio="xMidYMax meet"/>
   <% x -= w + 8.6; ts.first(6).each do |t| %>
   <g transform="translate(<%= (x - 25.38).round(2) %> 3.7)"><%= badge.(t) %></g>
   <% x -= 59.06; end; x -= 8 %>
   <% end %>
  </g>
  <% end %>
  <rect x="2851.46" y="172.51" width="535.57" height="139.01" rx="25.53" ry="23.62" class="fil5 str11"/>
  <text x="2869.92" y="237.85" class="fil3 fnt2" style="font-size:<%= (58.33 * [1.0, 440 / natgrotesk_width(data['name'], 58.33)].min).round(2) %>px"><%= e.(data['name']) %></text>
  <% unless title_en.empty? %>
  <text x="2869.92" y="285.1" class="fil4 fnt3" style="font-size:<%= (45.83 * [1.0, 440 / natgrotesk_width(title_en, 45.83)].min).round(2) %>px"><%= e.(title_en) %></text>
  <% end %>

  <polyline class="fil5 str12" points="3363.82,247.41 3347.16,264.07 3330.49,247.41"/>
  <line class="fil5 str12" x1="3347.16" y1="264.07" x2="3347.16" y2="219.96"/>

  <% stops.each_with_index do |s, i| y = (423.98 + pitch * i).round(2)
     if s['gap'] %>
  <text x="2869.92" y="<%= y %>" class="fil4" style="font-size:<%= (75 * text_scale).round(2) %>px">…</text>
  <% next end
     fit = [1.0, name_room / natgrotesk_width(s['name'], 58.33)].min
     digits = s['minutes'].to_s.length
     width = 73.23 + 16.54 * (digits - 1)
     offset = 34.3 + 17 * (digits - 1)
     eng = eng_name_for(s['code'], nil) %>
  <g transform="translate(2869.92 <%= y %>) scale(<%= text_scale.round(4) %>)">
   <text class="fil3 fnt2" style="font-size:<%= (58.33 * fit).round(2) %>px"><%= e.(s['name']) %></text>
   <% unless eng.empty? %>
   <text y="47.25" class="fil4 fnt3" style="font-size:<%= (45.83 * [1.0, name_room / natgrotesk_width(eng, 45.83)].min).round(2) %>px"><%= e.(eng) %></text>
   <% end %>
   <g transform="translate(<%= (natgrotesk_width(s['name'], 58.33) * fit + 18).round(2) %> -41.7)">
    <rect width="<%= width.round(2) %>" height="44.88" rx="3.87" ry="6.21" class="fil5 str13"/>
    <text x="7.7" y="35.6" class="fil4 fnt8"><%= s['minutes'] %></text>
    <text x="<%= offset.round(2) %>" y="19.5" class="fil4 fnt9">хв</text>
    <text x="<%= offset.round(2) %>" y="35.6" class="fil4 fnt9">min</text>
   </g>
  </g>
  <% end %>
 </g>
 <%= erb :'schedule-footer' %>
</svg>
