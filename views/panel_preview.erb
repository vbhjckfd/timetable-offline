<%
  name = data['name'].to_s
  name_en = data['name_en'].to_s
  title = "Зупинка №#{code} — #{name}"
  title += " / #{name_en}" if name_en.present? && name_en != name
  description = "Табличка в укритті на зупинці «#{name}», код #{code}. Розклад: lad.lviv.ua/#{code}"
  image = "#{base_url}/#{ERB::Util.url_encode(code)}/panel.png"
  page = "#{base_url}/#{ERB::Util.url_encode(code)}/panel"
%><!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= ERB::Util.h(title) %></title>
  <meta name="description" content="<%= ERB::Util.h(description) %>">
  <link rel="canonical" href="<%= ERB::Util.h(page) %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Lviv Transport">
  <meta property="og:locale" content="uk_UA">
  <meta property="og:url" content="<%= ERB::Util.h(page) %>">
  <meta property="og:title" content="<%= ERB::Util.h(title) %>">
  <meta property="og:description" content="<%= ERB::Util.h(description) %>">
  <meta property="og:image" content="<%= ERB::Util.h(image) %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= ERB::Util.h(title) %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ERB::Util.h(title) %>">
  <meta name="twitter:description" content="<%= ERB::Util.h(description) %>">
  <meta name="twitter:image" content="<%= ERB::Util.h(image) %>">
  <style>
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #444240; }
    img { max-width: 96vw; height: auto; }
  </style>
</head>
<body>
  <img src="<%= ERB::Util.h(image) %>" alt="<%= ERB::Util.h(title) %>">
</body>
</html>
